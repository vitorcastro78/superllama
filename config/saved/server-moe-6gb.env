# Target: RTX 4050 Laptop (Ada sm_89, ~6GB VRAM)
# SuperLlama turboquant ??? MoE profile for ~6GB VRAM GPUs
# Copy bin from build-cuda-turboquant; point ModelsDir at local GGUFs.
ModelsDir=C:\Models\gguf
Host=127.0.0.1
Port=11434
DefaultModel=
GpuLayers=99
CtxSize=8192
NPredict=1024
Parallel=1
FlashAttn=on
KvUnified=0
ModelsMax=1
Threads=8
# Prefer TurboQuant KV when build supports it; fallback: q4_0
CacheTypeK=turbo3
CacheTypeV=turbo3
CachePrompt=1
CacheReuse=256
SlotPromptSimilarity=0.30
SplitMode=none
MainGpu=0
Fit=on
# Offload MoE experts to system RAM (critical on 6GB)
# Extra args are appended by run bat / Manager ??? also set below as comments for CLI:
#   --n-cpu-moe 999   OR   -ot ".ffn_.*_exps.=CPU"
ExtraArgs=--n-cpu-moe 999
Agent=0
Tools=
Reasoning=off
WebUI=1
UiPath=C:\LlamaServer\ui\llama.ui
MediaPath=C:/
CudaVisibleDevices=0
Device=CUDA0
Jinja=1
RuntimeMode=Process
ModelsAutoload=0
Profile=moe-6gb-turbo3
