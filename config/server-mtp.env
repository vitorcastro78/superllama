# SuperLlama TurboQuant + MTP (optional preset — NOT production default)
# Requires Unsloth MTP GGUF (nextn / draft-mtp heads). IQ2_S de producao NAO serve.
# Model: unsloth/Qwen3.6-35B-A3B-MTP-GGUF → Qwen3.6-35B-A3B-UD-IQ2_M.gguf
# Bin: llama-server TurboQuant com --spec-type draft-mtp
# Ativar: copia sobre server.env (com backup) ou aponta o Manager para este ficheiro.
ModelsDir=C:\Models\gguf
Host=127.0.0.1
Port=11434
DefaultModel=qwen3.6-35b-mtp
Model=C:\Models\gguf\Qwen3.6-35B-A3B-UD-IQ2_M.gguf
UseRouter=0
GpuLayers=99
CtxSize=32768
NPredict=32768
Parallel=1
FlashAttn=on
KvUnified=0
ModelsMax=1
Threads=8
CacheTypeK=turbo3
CacheTypeV=turbo2
CachePrompt=1
CacheReuse=512
SlotPromptSimilarity=0.30
SplitMode=none
MainGpu=0
Fit=off
Agent=0
Tools=none
Reasoning=auto
ReasoningEffort=medium
ReasoningBudget=4096
ReasoningPreserve=0
WebUI=1
UiPath=C:\LlamaServer\ui\llama.ui
MediaPath=C:/
CudaVisibleDevices=0
Device=CUDA0
Jinja=1
RuntimeMode=Service
ModelsAutoload=0
Profile=iq2mtp-32k-turbo3k-turbo2v
# IQ2_M MTP; ctx 32k; KV turbo3/turbo2; draft-n-max 1
ExtraArgs=--spec-type draft-mtp --spec-draft-n-max 1
