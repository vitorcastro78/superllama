# Alias of server.env (same production TurboQuant defaults).
# Adjust ModelsDir / Model / MediaPath to the target machine before first start.
ModelsDir=C:\Models\gguf
Host=127.0.0.1
Port=11434
DefaultModel=qwen3.6-35b
Model=C:\Models\gguf\Qwen_Qwen3.6-35B-A3B-IQ2_S.gguf
UseRouter=0
GpuLayers=99
CtxSize=92160
NPredict=32768
Parallel=1
FlashAttn=on
KvUnified=0
ModelsMax=1
Threads=8
CacheTypeK=turbo4
CacheTypeV=turbo3
CachePrompt=1
CacheReuse=512
SlotPromptSimilarity=0.30
SplitMode=none
MainGpu=0
Fit=off
Agent=0
Tools=none
Reasoning=auto
ReasoningEffort=medium
ReasoningBudget=4096
ReasoningPreserve=0
WebUI=1
UiPath=C:\LlamaServer\ui\llama.ui
MediaPath=C:/
CudaVisibleDevices=0
Device=CUDA0
Jinja=1
RuntimeMode=Service
ModelsAutoload=0
Profile=super-qwen-90k-turbo4k-turbo3v
# KV K=turbo4 V=turbo3 (requires TurboQuant llama-server); ctx 90k
ExtraArgs=
