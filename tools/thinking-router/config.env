# Upstream llama-server
UPSTREAM=http://127.0.0.1:11434

HOST=127.0.0.1
PORT=11437

# GPU for GLiNER: empty=CPU | 0/1/... = physical index | auto = last GPU if 2+, else 0
CUDA_DEVICE=auto

GLINER_MODEL=fastino/GLiNER2.5-Decide
RESPECT_CLIENT_FLAG=1
LOG_DECISIONS=1
# 0 = always call GLiNER (recommended). 1 = regex short-circuit (skips GPU decision model).
USE_HEURISTIC=0
# Only used when USE_HEURISTIC=1: force thinking_off if request includes tools.
HEURISTIC_TOOLS_OFF=0
MIN_MAX_TOKENS=16384
